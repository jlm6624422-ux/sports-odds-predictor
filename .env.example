# === ODDS DATA ===
# The Odds API - https://the-odds-api.com/ (500 free requests/month)
ODDS_API_KEY=your_odds_api_key_here

# === SPORTS STATS ===
# Ball Don't Lie (NBA stats) - https://www.balldontlie.io/ (free tier)
BALL_DONT_LIE_KEY=

# College Football Data - https://collegefootballdata.com/ (free registration)
CFBD_API_KEY=

# ESPN, MLB Stats API, Open-Meteo - NO KEYS NEEDED (free public APIs)

# === SERVER CONFIG ===
SERVER_PORT=3001
SERVER_HOST=127.0.0.1

# === MODEL SERVICE ===
MODEL_SERVICE_URL=http://127.0.0.1:8001

# === DATABASE ===
DB_PATH=./server/data/sports_odds.db
